{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "height": 17,
    "source": "~/.config/fastfetch/cc_warm_term.png",
    "padding": {
        "top": 1,
        "left": 2,
        "right": 2
    }
  },
  "display": {
    "separator": " ⟫ ",
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;5;118m     SYSTEM ARCHITECTURE"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;239m┌──────────────────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "  󰣇 OS       ",
      "format": "{2}",
      "keyColor": "38;5;39"
    },
    {
      "type": "kernel",
      "key": "   Kernel   ",
      "format": "{2}",
      "keyColor": "38;5;213"
    },
    {
      "type": "packages",
      "key": "  󰏗 Packages ",
      "keyColor": "32;6;81"
    },
    {
      "type": "display",
      "key": "  󰍹 Display  ",
      "format": "{1}x{2} @ {3}Hz",
      "keyColor": "38;5;141"
    },
    {
      "type": "wm",
      "key": "  󱗃 WM       ",
      "format": "{2}",
      "keyColor": "38;5;220"
    },
    {
      "type": "terminal",
      "key": "  >_ Terminal",
      "keyColor": "38;100;44"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;239m└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[32;5;214m     HARDWARE STATUS"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;239m┌──────────────────────────────────────────────────────┐"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": "   CPU     ",
      "keyColor": "38;5;202"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "  󰊴 GPU     ",
      "keyColor": "38;5;111"
    },
    {
      "type": "memory",
      "key": "    Memory ",
      "keyColor": "38;5;46"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime  ",
      "keyColor": "38;5;135"
    },
    {
      "type": "command",
      "key": "  󱦟 OS Age  ",
      "keyColor": "38;35;160",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;239m└──────────────────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}